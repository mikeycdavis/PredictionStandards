      "rule": "confidence.not-probability"
    },
    {
      "number": 3,
      "text": "confuse probability with expected value",
      "source": "artifacts/prompt/original-prompt.md",
      "standard": 1,
      "rule": "probability.not-expected-value"
    },
    {
      "number": 4,
      "text": "call a tiny modeled difference meaningful without justification",
      "source": "artifacts/prompt/original-prompt.md",
