{
  "name": "prediction-standards",
  "version": "1.0.0",
  "description": "Numbered prediction standards, and the command that checks whether an individual prediction is sufficiently supported.",
  "type": "module",
  "bin": { "predictions": "scripts/predictions.mjs" },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "audit": "node scripts/predictions.mjs audit examples/records",
    "audit:strict": "node scripts/predictions.mjs audit examples/records --strict",
    "check": "node scripts/predictions.mjs check examples/records",
    "inventory": "node scripts/inventory.mjs",
    "fidelity": "node scripts/fidelity.mjs",
    "integrity": "node scripts/integrity.mjs",
    "policy": "node scripts/policy.mjs",
    "diagrams": "node scripts/diagrams.mjs"
  },
  "engines": { "node": ">=18" },
  "license": "UNLICENSED",
  "private": true
}
