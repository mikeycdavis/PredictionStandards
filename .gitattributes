# Shell scripts must check out with LF on every platform.
#
# This is not a style preference. `scripts/ci.sh` runs inside a Linux container and on the hosted
# runner; a copy checked out with CRLF fails at the shebang with `/usr/bin/env: 'sh\r': No such
# file or directory`, which reads as a missing interpreter rather than as a line-ending problem and
# is why it costs an hour the first time. This machine has core.autocrlf enabled, so without this
# rule the working copy diverges from the committed bytes the moment git touches the file.
*.sh text eol=lf

# Same reasoning: the entrypoint is parsed by a shell inside the image.
Dockerfile.ci text eol=lf

# Externally produced bytes, copied verbatim from a named producer commit (see
# schemas/vendor/provenance.json). `-text` disables line-ending translation entirely, so a checkout
# on a machine with core.autocrlf cannot rewrite bytes this repository did not author.
# test/adapter-contract.test.mjs compares this file against the authoritative one character for
# character; without this rule that comparison would fail on Windows and pass on Linux, which is a
# fact about the developer rather than about the protocol.
schemas/vendor/*.json  -text
